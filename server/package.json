{
    "name": "auto-hr-server",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "postinstall": "prisma generate",
        "dev": "tsx watch src/index.ts",
        "build": "tsc && node -e \"require('node:fs').cpSync('src/assets','dist/assets',{recursive:true})\"",
        "start": "node dist/index.js",
        "start:biometric": "node dist/biometricServer.js",
        "dev:biometric": "tsx watch src/biometricServer.ts",
        "db:generate": "prisma generate",
        "db:push": "prisma db push",
        "db:migrate": "prisma migrate dev",
        "db:seed": "tsx prisma/seed.ts",
        "db:studio": "prisma studio",
        "migrate:storage": "tsx scripts/migrateBase64ToStorage.ts",
        "users:provision": "tsx src/scripts/provisionEmployeeUsers.ts",
        "lint": "eslint src/"
    },
    "dependencies": {
        "@prisma/client": "^6.5.0",
        "basic-ftp": "^6.0.1",
        "bcrypt": "^5.1.1",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^17.3.1",
        "express": "^4.21.2",
        "express-rate-limit": "^7.5.0",
        "helmet": "^8.0.0",
        "jsonwebtoken": "^9.0.2",
        "multer": "^1.4.5-lts.1",
        "nodemailer": "^6.9.16",
        "pdf-lib": "^1.17.1",
        "xlsx": "^0.18.5",
        "xml2js": "^0.6.2",
        "zod": "^3.24.2"
    },
    "devDependencies": {
        "@types/bcrypt": "^5.0.2",
        "@types/cookie-parser": "^1.4.8",
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.0",
        "@types/jsonwebtoken": "^9.0.7",
        "@types/multer": "^1.4.12",
        "@types/node": "^22.13.9",
        "@types/nodemailer": "^6.4.17",
        "@types/xml2js": "^0.4.14",
        "prisma": "^6.5.0",
        "tsx": "^4.19.3",
        "typescript": "^5.7.3"
    }
}
