DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=3306
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DBNAME"

# JWT
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_STRING
JWT_EXPIRES_IN=24h

# SMTP (for email) — e.g. Gmail: host smtp.gmail.com, port 587, user/pass = an App Password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Server
PORT=3001
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Salary / Payroll Integration
SALARY_API_KEY=your_secure_random_api_key_here
SALARY_ENCRYPTION_KEY=your_secure_32_character_encryption_key_here

# Upload storage — "local" writes to server/uploads (default, dev only).
# Use "hostinger-ftp" in production (e.g. Vercel) since serverless disks are ephemeral.
UPLOAD_STORAGE_DRIVER=local
UPLOAD_PUBLIC_BASE_URL=https://your-frontend-domain/uploads
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=
FTP_SECURE=false
FTP_REMOTE_ROOT=/public_html/uploads

# Biometric push receiver (npm run start:biometric — separate process, raw TCP)
# Device menu: Comm -> Event Transfer Mode = TCP/IP, Host PC Addr = this server, Host PC Port = BIOMETRIC_PORT
BIOMETRIC_PORT=5005
# Comma-separated device serials allowed to push; empty = accept any
BIOMETRIC_ALLOWED_SERIALS=
